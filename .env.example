# Optional. The local tools work without any credentials.
# Server-only: NEVER prefix a secret with VITE_ or put it in frontend code.
GROQ_API_KEY=
# A separate random application access code, 12-200 characters. Not your API key.
AI_ACCESS_CODE=
# Check the models and free-tier limits in your own account.
GROQ_MODEL=openai/gpt-oss-120b
# Optional deployment-wide daily ceiling (UTC day); in-process, resets on restart.
AI_DAILY_LIMIT=40
# Optional server tuning. Defaults are safe; raise only with a quota budget.
AI_PROVIDER=groq
AI_MAX_TOKENS=4096
# Capped at 25000 so the app always answers before the platform's 30s limit.
AI_TIMEOUT_MS=24000
# Where the client address comes from. Leave empty unless your platform sets a
# forwarding header you control: an unset value means every request shares one
# bucket, which is safe but coarse. Allowed: x-forwarded-for | x-real-ip |
# cf-connecting-ip | x-vercel-forwarded-for. Vercel: x-forwarded-for.
# The LAST hop of the header is used, because earlier hops may be forged.
AI_TRUSTED_PROXY=
# Comma-separated absolute origins allowed to call this proxy from another host.
# Empty = same-origin only. Example: https://USERNAME.github.io
AI_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Public build-time identity. These are NOT secrets: they are shipped to the
# browser on purpose. CI fills them from the GitHub context, so renaming the
# repository or switching to a custom domain needs no code change.
# ---------------------------------------------------------------------------
# VITE_BRAND_AR=لك
# VITE_BRAND_LATIN=celia.sh
# VITE_SITE_TITLE=
# VITE_SITE_DESCRIPTION=
# VITE_REPO_URL=https://github.com/OWNER/REPO
# VITE_SITE_URL=https://OWNER.github.io/REPO/
# Separate API proxy origin (option B). Empty = same origin, relative URLs.
# VITE_API_BASE=https://your-proxy.example.com
# VITE_THEME_COLOR=#7660d3
# Build-only, never sent to the browser:
# SITE_BASE=./
# SITE_CNAME=celia.sh
