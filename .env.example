# Optional. The three local tools work without any credentials.
# Server-only: NEVER prefix this with VITE_ or put it in frontend code.
GROQ_API_KEY=
# A separate random application access code, 12-200 characters. Not your API key.
AI_ACCESS_CODE=
# Check the models and free-tier limits in your own Groq account.
GROQ_MODEL=openai/gpt-oss-120b
# Optional deployment-wide daily ceiling (UTC day); resets on a server restart.
AI_DAILY_LIMIT=40
