{
  "name": "celia-sh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "test:browser": "playwright test",
    "test:smoke": "node scripts/smoke-deploy.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:sql": "node scripts/check-sql.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "economics": "node scripts/unit-economics.mjs",
    "report:maintenance": "node scripts/maintenance-report.mjs",
    "agent:guards": "node scripts/agent-guards.mjs",
    "agent:dry": "node scripts/maintenance-agent.mjs --dry-run",
    "render:og": "node scripts/render-og-image.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.1.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "minimatch": "^11.0.5",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "$minimatch"
  }
}
